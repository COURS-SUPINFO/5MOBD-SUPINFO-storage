# Copy to `.env` (docker compose reads it automatically). Every value has a default in
# docker-compose.yml, so this file is only needed to override them.

MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=mesbonnesadresses

# URL of MinIO as seen by the APP (not by other containers):
#   Web / iOS simulator     -> http://localhost:9000
#   Android emulator        -> http://10.0.2.2:9000
#   Physical phone (LAN)    -> http://<LAN-IP-of-this-machine>:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
